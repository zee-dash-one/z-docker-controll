{
  "version": 1,
  "settings": {
    "backupFolder": "",
    "pollSeconds": 8,
    "logTailLines": 80
  },
  "services": [
    {
      "id": "9router",
      "displayName": "9Router",
      "category": "gateway",
      "enabled": true,
      "managed": true,
      "containerName": "9router",
      "image": "decolua/9router:latest",
      "hostPort": 20128,
      "containerPort": 20128,
      "volumes": [],
      "env": {},
      "stopTimeoutSeconds": 15,
      "openUrl": "http://localhost:20128",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": true,
      "firewallRuleName": "ZLab 9Router 20128",
      "notes": "Gateway de IA — habilitado por padrão."
    },
    {
      "id": "omniroute",
      "displayName": "OmniRoute",
      "category": "gateway",
      "enabled": true,
      "managed": true,
      "containerName": "omniroute",
      "image": "diegosouzapw/omniroute:latest",
      "hostPort": 20129,
      "containerPort": 20128,
      "volumes": ["omniroute-data:/app/data"],
      "env": {},
      "stopTimeoutSeconds": 40,
      "openUrl": "http://localhost:20129",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": true,
      "firewallRuleName": "ZLab OmniRoute 20129",
      "notes": "Gateway unificado — habilitado por padrão. stopTimeout 40s (SQLite)."
    },
    {
      "id": "postgres",
      "displayName": "PostgreSQL",
      "category": "database",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-postgres",
      "image": "postgres:16",
      "hostPort": 5432,
      "containerPort": 5432,
      "volumes": ["zlab-postgres-data:/var/lib/postgresql/data"],
      "env": {
        "POSTGRES_USER": "zlab",
        "POSTGRES_PASSWORD": "CHANGE_ME",
        "POSTGRES_DB": "zlab"
      },
      "stopTimeoutSeconds": 20,
      "openUrl": "",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab Postgres 5432",
      "notes": "Desativado. V1: volumeCopy opcional após ativar. V2: pgDump. Defina POSTGRES_PASSWORD antes de Iniciar."
    },
    {
      "id": "mysql",
      "displayName": "MySQL",
      "category": "database",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-mysql",
      "image": "mysql:8",
      "hostPort": 3306,
      "containerPort": 3306,
      "volumes": ["zlab-mysql-data:/var/lib/mysql"],
      "env": {
        "MYSQL_ROOT_PASSWORD": "CHANGE_ME",
        "MYSQL_DATABASE": "zlab"
      },
      "stopTimeoutSeconds": 20,
      "openUrl": "",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab MySQL 3306",
      "notes": "Desativado. Altere MYSQL_ROOT_PASSWORD antes de usar."
    },
    {
      "id": "redis",
      "displayName": "Redis",
      "category": "database",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-redis",
      "image": "redis:7",
      "hostPort": 6379,
      "containerPort": 6379,
      "volumes": ["zlab-redis-data:/data"],
      "env": {},
      "stopTimeoutSeconds": 10,
      "openUrl": "",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": false,
      "firewallRuleName": "ZLab Redis 6379",
      "notes": "Desativado. Cache / filas."
    },
    {
      "id": "mongodb",
      "displayName": "MongoDB",
      "category": "database",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-mongodb",
      "image": "mongo:7",
      "hostPort": 27017,
      "containerPort": 27017,
      "volumes": ["zlab-mongo-data:/data/db"],
      "env": {},
      "stopTimeoutSeconds": 20,
      "openUrl": "",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab MongoDB 27017",
      "notes": "Desativado."
    },
    {
      "id": "n8n",
      "displayName": "n8n",
      "category": "api",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-n8n",
      "image": "n8nio/n8n:latest",
      "hostPort": 5678,
      "containerPort": 5678,
      "volumes": ["zlab-n8n-data:/home/node/.n8n"],
      "env": {},
      "stopTimeoutSeconds": 20,
      "openUrl": "http://localhost:5678",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": false,
      "firewallRuleName": "ZLab n8n 5678",
      "notes": "Desativado. Automação / workflows HTTP."
    },
    {
      "id": "generic-api",
      "displayName": "API genérica",
      "category": "api",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-api",
      "image": "nginx:alpine",
      "hostPort": 8080,
      "containerPort": 80,
      "volumes": [],
      "env": {},
      "stopTimeoutSeconds": 10,
      "openUrl": "http://localhost:8080",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab API 8080",
      "notes": "Desativado. Template placeholder — troque image/ports no JSON pela sua API."
    },
    {
      "id": "ollama",
      "displayName": "Ollama",
      "category": "llm",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-ollama",
      "image": "ollama/ollama:latest",
      "hostPort": 11434,
      "containerPort": 11434,
      "volumes": ["zlab-ollama-data:/root/.ollama"],
      "env": {},
      "stopTimeoutSeconds": 30,
      "openUrl": "http://localhost:11434",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": false,
      "firewallRuleName": "ZLab Ollama 11434",
      "notes": "Desativado. LLMs locais. Requer GPU/recursos adequados no host."
    },
    {
      "id": "comfyui",
      "displayName": "ComfyUI",
      "category": "media",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-comfyui",
      "image": "yanwk/comfyui-boot:latest",
      "hostPort": 8188,
      "containerPort": 8188,
      "volumes": [],
      "env": {},
      "stopTimeoutSeconds": 40,
      "openUrl": "http://localhost:8188",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab ComfyUI 8188",
      "notes": "Desativado. Geração de imagem. Confirme a imagem Docker adequada ao seu hardware."
    },
    {
      "id": "whisper",
      "displayName": "Whisper (STT)",
      "category": "media",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-whisper",
      "image": "onerahmet/openai-whisper-asr-webservice:latest",
      "hostPort": 9000,
      "containerPort": 9000,
      "volumes": [],
      "env": {},
      "stopTimeoutSeconds": 30,
      "openUrl": "http://localhost:9000",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab Whisper 9000",
      "notes": "Desativado. Speech-to-text (áudio → texto)."
    },
    {
      "id": "piper-tts",
      "displayName": "Piper TTS",
      "category": "media",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-piper",
      "image": "ohdoki/piper-http:latest",
      "hostPort": 5000,
      "containerPort": 5000,
      "volumes": [],
      "env": {},
      "stopTimeoutSeconds": 20,
      "openUrl": "http://localhost:5000",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab Piper 5000",
      "notes": "Desativado. Text-to-speech. Ajuste a imagem se preferir outro TTS."
    },
    {
      "id": "portainer",
      "displayName": "Portainer",
      "category": "other",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-portainer",
      "image": "portainer/portainer-ce:latest",
      "hostPort": 9443,
      "containerPort": 9443,
      "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock",
        "zlab-portainer-data:/data"
      ],
      "env": {},
      "stopTimeoutSeconds": 15,
      "openUrl": "https://localhost:9443",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": false,
      "firewallRuleName": "ZLab Portainer 9443",
      "notes": "Desativado. UI Docker complementar (não substitui o Z-Lab)."
    }
  ]
}
