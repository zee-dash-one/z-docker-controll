    },
    {
      "id": "ollama",
      "displayName": "Ollama",
      "category": "llm",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-ollama",
      "image": "ollama/ollama:latest",
      "hostPort": 11434,
      "containerPort": 11434,
