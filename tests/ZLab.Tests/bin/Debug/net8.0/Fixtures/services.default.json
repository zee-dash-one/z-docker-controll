      "openUrl": "https://localhost:9443",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": false,
      "firewallRuleName": "ZLab Portainer 9443",
      "notes": "Desativado. UI Docker complementar (não substitui o Z-Lab)."
