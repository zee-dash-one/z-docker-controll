{
  "version": 1,
  "settings": {
    "backupFolder": "",
    "pollSeconds": 8,
    "logTailLines": 80,
    "backupDailyEnabled": true,
    "backupDailyTime": "03:00",
    "lastAutoBackupDate": ""
  },
  "services": [
    {
      "id": "9router",
      "displayName": "9Router",
      "category": "gateway",
      "enabled": true,
      "managed": true,
      "containerName": "9router",
      "image": "decolua/9router:latest",
      "hostPort": 20128,
      "containerPort": 20128,
      "volumes": ["9router-data:/app/data"],
      "env": {
        "INITIAL_PASSWORD": "123456"
      },
      "stopTimeoutSeconds": 15,
      "openUrl": "http://localhost:20128",
      "localHost": "9router-local",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": true,
      "firewallRuleName": "ZLab 9Router 20128",
      "notes": "Gateway de IA — habilitado por padrão. INITIAL_PASSWORD só no 1º boot (volume). Hosts locais = 9router-local. Tunnel Cloudflare: use botão Tunnel no Z-Lab (CLI token); a UI do 9Router no browser Windows mostra Local only."
    },
    {
      "id": "omniroute",
      "displayName": "OmniRoute",
      "category": "gateway",
      "enabled": true,
      "managed": true,
      "containerName": "omniroute",
      "image": "diegosouzapw/omniroute:latest",
      "hostPort": 20129,
      "containerPort": 20128,
      "volumes": ["omniroute-data:/app/data"],
      "env": {
        "CLOUDFLARED_PROTOCOL": "http2"
      },
      "stopTimeoutSeconds": 40,
      "openUrl": "http://127.0.0.1:20129",
      "localHost": "omniroute-local",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": true,
      "firewallRuleName": "ZLab OmniRoute 20129",
      "notes": "Gateway unificado. Hosts locais = omniroute-local. Cloud OmniRoute (sync) ≠ Cloudflare Quick Tunnel — ative Quick Tunnel no dashboard Endpoints (Install & Enable). Não restaura após restart."
    },
    {
      "id": "tailscale",
      "displayName": "Tailscale",
      "category": "gateway",
      "enabled": true,
      "managed": true,
      "containerName": "tailscale-9router",
      "image": "tailscale/tailscale:latest",
      "hostPort": 0,
      "containerPort": 0,
      "networkMode": "host",
      "capAdd": ["NET_ADMIN", "NET_RAW"],
      "hostname": "9router-serve",
      "envFile": "/mnt/c/GIT/ZAPFCOORP/tailscale-9router/.env",
      "volumes": [
        "tailscale-9router-state:/var/lib/tailscale",
        "/mnt/c/GIT/ZAPFCOORP/tailscale-9router/config:/config:ro"
      ],
      "env": {
        "TS_USERSPACE": "true",
        "TS_SERVE_CONFIG": "/config/serve.json",
        "TS_HOSTNAME": "9router-serve",
        "TS_STATE_DIR": "/var/lib/tailscale",
        "TS_EXTRA_ARGS": "--advertise-tags=tag:9router"
      },
      "stopTimeoutSeconds": 15,
      "openUrl": "",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "",
      "notes": "Saída Tailscale dos combos. 443 → 9router (20128), 8443 → omniroute (20129). A chave fica só no .env (guia 05-conta-e-chave.md), nunca neste JSON. Suba 9router e OmniRoute antes. Sem Funnel e sem exit node."
    },
    {
      "id": "postgres",
      "displayName": "PostgreSQL",
      "category": "database",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-postgres",
      "image": "postgres:16",
      "hostPort": 5432,
      "containerPort": 5432,
      "volumes": ["zlab-postgres-data:/var/lib/postgresql/data"],
      "env": {
        "POSTGRES_USER": "zlab",
        "POSTGRES_PASSWORD": "CHANGE_ME",
        "POSTGRES_DB": "zlab"
      },
      "stopTimeoutSeconds": 20,
      "openUrl": "",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab Postgres 5432",
      "notes": "Desativado. V1: volumeCopy opcional após ativar. V2: pgDump. Defina POSTGRES_PASSWORD antes de Iniciar."
    },
    {
      "id": "mysql",
      "displayName": "MySQL",
      "category": "database",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-mysql",
      "image": "mysql:8",
      "hostPort": 3306,
      "containerPort": 3306,
      "volumes": ["zlab-mysql-data:/var/lib/mysql"],
      "env": {
        "MYSQL_ROOT_PASSWORD": "CHANGE_ME",
        "MYSQL_DATABASE": "zlab"
      },
      "stopTimeoutSeconds": 20,
      "openUrl": "",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab MySQL 3306",
      "notes": "Desativado. Altere MYSQL_ROOT_PASSWORD antes de usar."
    },
    {
      "id": "redis",
      "displayName": "Redis",
      "category": "database",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-redis",
      "image": "redis:7",
      "hostPort": 6379,
      "containerPort": 6379,
      "volumes": ["zlab-redis-data:/data"],
      "env": {},
      "stopTimeoutSeconds": 10,
      "openUrl": "",
      "health": { "type": "docker" },
      "backup": { "mode": "volumeCopy" },
      "exposeLan": false,
      "firewallRuleName": "ZLab Redis 6379",
      "notes": "Desativado. Cache / filas."
    },
    {
      "id": "mongodb",
      "displayName": "MongoDB",
      "category": "database",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-mongodb",
      "image": "mongo:7",
      "hostPort": 27017,
      "containerPort": 27017,
      "volumes": ["zlab-mongo-data:/data/db"],
      "env": {},
