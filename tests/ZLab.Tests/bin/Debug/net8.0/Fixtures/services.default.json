      "openUrl": "",
      "health": { "type": "docker" },
      "backup": { "mode": "none" },
      "exposeLan": false,
      "firewallRuleName": "ZLab MongoDB 27017",
      "notes": "Desativado."
    },
    {
      "id": "n8n",
      "displayName": "n8n",
      "category": "api",
      "enabled": false,
      "managed": true,
      "containerName": "zlab-n8n",
